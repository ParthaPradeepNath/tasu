# Neon Postgres — pooled connection used by the app at runtime
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct (unpooled) connection used by Prisma CLI for migrations
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
